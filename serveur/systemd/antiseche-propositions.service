[Unit]
Description=Antisèche : réception des propositions de correction (POST /api/proposition)
After=network.target

[Service]
User=antiseche
Group=antiseche
Environment=PORT=8092
Environment=PROPOSITIONS_FICHIER=/srv/antiseche/propositions/propositions.jsonl
ExecStart=/usr/bin/node /srv/antiseche/repo/serveur/propositions.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/antiseche/propositions

[Install]
WantedBy=multi-user.target
